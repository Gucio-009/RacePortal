# Skopiuj do `.env` w katalogu projektu (gitignored). Compose podstawia te zmienne.
#
# Lokalnie:
#   PUBLIC_BASE_URL=http://localhost:8081
# Produkcja (Oracle / raceportal.pl):
#   PUBLIC_BASE_URL=https://raceportal.pl

SMTP_PASSWORD=
PUBLIC_BASE_URL=https://raceportal.pl
# Prod: współdzielona sesja apex ↔ bo.raceportal.pl
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.raceportal.pl
# Google Sign-In — ten sam Client ID w obu (Web OAuth client z Google Cloud).
# Bez wartości przycisk Google jest ukryty. Client Secret nie jest potrzebny (GIS + weryfikacja idToken).
# W Google Cloud dodaj Authorized JavaScript origin: https://bo.raceportal.pl
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
