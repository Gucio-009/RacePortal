# Opcjonalnie — Google Sign-In (ten sam Client ID co GOOGLE_OAUTH_CLIENT_ID w API).
# Google Cloud Console → OAuth client (Web). Origins: https://raceportal.pl (+ localhost do dev).
# Przy Docker Compose wystarczy root `.env` (VITE_GOOGLE_CLIENT_ID jako build-arg).
# Client Secret nie jest używany — tylko Client ID.
VITE_GOOGLE_CLIENT_ID=
