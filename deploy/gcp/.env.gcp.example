# Skopiuj na VM: cp deploy/gcp/.env.gcp.example deploy/gcp/.env.gcp
# NIE commituj pliku .env.gcp (hasła / JWT).

# MySQL
MYSQL_ROOT_PASSWORD=zmien-root-haslo
MYSQL_DATABASE=raceportal
MYSQL_USER=raceportal
MYSQL_PASSWORD=zmien-db-haslo

# API
JWT_SECRET=zmien-na-dlugi-losowy-ciag-min-32-znaki
# Demo/dyplom: seed + insecure defaults RAZEM (validator ich nie łączy z false).
# Produkcja „twarda”: SEED_ENABLED=false i ALLOW_INSECURE_DEFAULTS=false.
SEED_ENABLED=true
ALLOW_INSECURE_DEFAULTS=true
GOOGLE_OAUTH_CLIENT_ID=

# Origins frontu (Cloudflare Pages + custom domain)
CORS_ORIGIN=https://www.raceportal.pl,https://raceportal.pl,https://*.pages.dev

# SMTP Mailbux — maile idą na skrzynki użytkowników. Hasła nie commituj w tym pliku po skopiowaniu.
SMTP_HOST=my.mailbux.com
SMTP_PORT=587
SMTP_USERNAME=kontakt@raceportal.pl
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=RACEPORTAL <kontakt@raceportal.pl>
