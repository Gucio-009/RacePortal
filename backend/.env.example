# RacePortal API env (Docker Compose)
DATABASE_URL=jdbc:mysql://mysql:3306/raceportal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=raceportal
DATABASE_PASSWORD=raceportal
# SMTP Mailbux. Hasło trzymaj w pliku .env w katalogu projektu (gitignored): SMTP_PASSWORD=...
SMTP_HOST=my.mailbux.com
SMTP_PORT=587
SMTP_USERNAME=noreply@raceportal.pl
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=RACEPORTAL <noreply@raceportal.pl>
# Front URL w mailach (link aktywacyjny). Compose i tak bierze PUBLIC_BASE_URL z `.env` w root.
# Lokalnie: http://localhost:8081 | Prod: https://raceportal.pl
PUBLIC_BASE_URL=https://raceportal.pl
CORS_ORIGIN=http://localhost:8081,http://127.0.0.1:8081,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8082,http://127.0.0.1:8082
JWT_SECRET=raceportal-dev-secret-change-me
SEED_ENABLED=true
GOOGLE_MAPS_API_KEY=
# Google Sign-In (ten sam Client ID co VITE_GOOGLE_CLIENT_ID na froncie)
GOOGLE_OAUTH_CLIENT_ID=
