{
  "name": "raceportal",
  "private": true,
  "version": "0.0.1",
  "description": "RacePortal monorepo — web, API, mobile, tests",
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "test": "npm run test:api && npm run test:e2e && npm run test:mobile-unit",
    "test:api": "npm --prefix backend test",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test tests/e2e/web.spec.ts",
    "test:e2e:mobile": "playwright test tests/e2e/mobile.spec.ts",
    "test:mobile-unit": "npm --prefix mobile exec vitest run",
    "test:report": "bash scripts/run-tests.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
